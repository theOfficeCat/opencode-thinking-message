{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-thinking-message",
  "version": "0.1.0",
  "description": "opencode TUI plugin that replaces the reasoning header with a rotating \"what is the model doing\" message",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "tui",
    "reasoning",
    "thinking"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.14.21",
    "@opencode-ai/sdk": "^1.14.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
